# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/ProfilerCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Rider / VS Code / VS
.idea/
.vs/
.vscode/

# OS
.DS_Store
Thumbs.db
Thumbs.db.meta
desktop.ini

# 실험용 — 커밋 안 함 (GrappleFireMask 만들다 나온 중간 산출물)
/Assets/Project/AnimationFold/SwingArmMask 1.mask
/Assets/Project/AnimationFold/SwingArmMask 1.mask.meta

# Asset Store 팩: 용량이 커서 GitHub에 안 올림. Package Manager › My Assets에서 다시 Import
/[Aa]ssets/vrbn_studios/
/[Aa]ssets/vrbn_studios.meta
